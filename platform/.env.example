# ─── Database (Neon Postgres) ────────────────────────────────────────────────
# Pooled connection string (used by the app at runtime).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
# Direct (unpooled) connection — used by prisma migrate.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# ─── Auth.js v5 ──────────────────────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Canonical URL of the deployment (no trailing slash).
AUTH_URL="https://apps.metricbase.org"

# Admin panel bootstrap: comma-separated emails treated as platform super-admins
# even before any User.isSuperAdmin row is set. Lets the first admin sign in and
# grant super-admin to others via /admin; can be dropped afterwards.
SUPERADMIN_EMAILS=""

# Google OAuth
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Resend — magic-link sign-in (Auth.js).
AUTH_RESEND_KEY=""
# Resend — transactional notifications (lib/email.ts: digest + instant emails).
# Usually the SAME Resend key as AUTH_RESEND_KEY. If blank, email is a silent no-op.
RESEND_API_KEY=""
EMAIL_FROM="MetricBase <noreply@metricbase.org>"
# Absolute base URL used to build links inside notification emails (no trailing /).
APP_URL="https://apps.metricbase.org"

# ─── Cron routes (scheduler) ─────────────────────────────────────────────────
# Shared secret the `cron` service sends as a Bearer token to /api/cron/*.
# Required — the cron routes return 500/401 without it. Generate:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=""

# ─── Telegram bot worker ─────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=""
# Shared secret the bot uses to call /api/bot/* on the web service.
# The web app reads the SAME value to authenticate inbound bot requests.
BOT_SERVICE_TOKEN=""
# Bot's @username (no @) — used to build the Settings → Telegram deep link.
TELEGRAM_BOT_USERNAME=""

# ─── Field compute engine (Python service) ───────────────────────────────────
# Shared secret the web app sends as X-Engine-Token when proxying analytics.
FIELD_ENGINE_TOKEN=""
# Base URL of the field-engine service. Compose service name in Docker; use
# http://localhost:5001 when running the engine locally (run-local.ps1).
FIELD_ENGINE_BASE="http://field-engine:5001"
# Web→engine request timeout (ms). Default 6000. Bump for local dev when testing
# against a distant Neon (cross-region query latency adds up).
# FIELD_ENGINE_TIMEOUT_MS="15000"
# Engine DB connection pool (pre-warmed at first use). Defaults 2 / 8.
# FIELD_ENGINE_POOL_MIN="2"
# FIELD_ENGINE_POOL_MAX="8"

# ─── Bot ↔ web (local dev) ───────────────────────────────────────────────────
# Web API base the bot calls. http://web:3000 in Docker (the default); set to
# http://localhost:3000 when running the bot locally without Docker.
# PLATFORM_API_BASE="http://localhost:3000"

# ─── Dev only ────────────────────────────────────────────────────────────────
# Comma-separated LAN origins allowed by the dev server over HTTPS.
DEV_ORIGINS=""
