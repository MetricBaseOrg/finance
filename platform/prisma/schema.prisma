// MetricBase Platform — unified schema.
// Phase 0: shared core only. Module tables (projects / finance / field) are
// added in their respective phases, each keyed by organizationId.
//
// Org-as-hub tenancy: every tenant-scoped row hangs off an Organization.
// Users are global identities; Membership links a User to an Organization
// with a role and is the single source of truth for user management.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth.js v5 standard models ──────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  // bcrypt hash for the Credentials provider; null for OAuth/magic-link users.
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  members       Membership[]
  msAccount     MicrosoftAccount?
  activities    Activity[]
  notifications Notification[]
  auditLogs     AuditLog[]      @relation("AuditActor")
  invitesSent   OrgInvite[]     @relation("InvitesSent")
  invitesAccepted OrgInvite[]   @relation("InvitesAccepted")

  // Projects module
  comments            Comment[]
  createdTasks        Task[]           @relation("TaskCreator")
  assignedTasks       Task[]           @relation("TaskAssignee")
  uploadedAttachments TaskAttachment[]
  taskActivities      TaskActivity[]
  taskNotifications   TaskNotification[]
  createdProjects     Project[]
  createdTemplates    Template[]

  // Field module
  fieldDashboards     UserDashboard[]
  fieldFormulas       UserFormula[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// One-to-one with User. Per-user Microsoft Graph OAuth tokens for OneDrive
// attachment uploads (Projects module). Refresh token AES-GCM encrypted at rest.
model MicrosoftAccount {
  id                String    @id @default(cuid())
  userId            String    @unique
  msUserId          String
  email             String?
  displayName       String?
  refreshTokenEnc   String
  accessToken       String?
  accessTokenExpiry DateTime?
  scope             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Organization (tenant hub) & membership ──────────────────────────────────

enum OrgType {
  INDIVIDUAL
  COMPANY
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

// The shared tenant. Collapses ProBase Workspace + finance Workspace +
// FieldFlow company into one entity. Module tables reference organizationId.
model Organization {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  type         OrgType  @default(COMPANY)
  // Default reporting currency for the Finance module ("IDR" | "USD").
  baseCurrency String   @default("IDR")
  timezone     String   @default("Asia/Jakarta")
  // Used by the Projects module workspace UI (ProBase carried these on Workspace).
  description  String?
  color        String   @default("#6366f1")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members       Membership[]
  invites       OrgInvite[]
  activities    Activity[]
  auditLogs     AuditLog[]
  notifications Notification[]

  // Finance module
  finAccounts         FinAccount[]
  categories          Category[]
  transactions        Transaction[]
  tags                Tag[]
  recurringRules      RecurringRule[]
  positions           Position[]
  investmentPositions InvestmentPosition[]

  // Projects module
  projects            Project[]
  templates           Template[]

  // Field module
  nodes               Node[]
  flows               Flow[]
  transfers           Transfer[]
  liftings            Lifting[]
  targets             Target[]
}

model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           Role     @default(OWNER)
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model OrgInvite {
  id             String    @id @default(cuid())
  organizationId String
  // Optional targeted email; null invites are open links anyone can accept.
  email          String?
  role           Role      @default(MEMBER)
  token          String    @unique @default(cuid())
  invitedById    String
  acceptedById   String?
  acceptedAt     DateTime?
  expiresAt      DateTime
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitesSent", fields: [invitedById], references: [id], onDelete: Cascade)
  acceptedBy   User?        @relation("InvitesAccepted", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([email])
}

// ─── Cross-cutting: audit, notifications, activity ───────────────────────────

// Append-only audit trail across every module (created in Phase 6 cross-cutting,
// modeled now so module writes can target it from the start).
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String?
  // "projects" | "finance" | "field" | "core"
  module         String
  action         String
  // Affected entity, e.g. "Transaction" / "Task" / "Lifting".
  entity         String?
  entityId       String?
  // JSON blob of before/after or contextual detail.
  metadata       String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, module])
  @@index([entity, entityId])
}

model Notification {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  module         String
  title          String
  body           String?
  // Deep link into the relevant module page.
  href           String?
  readAt         DateTime?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model Activity {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  module         String
  verb           String
  summary        String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, module])
}

// ═══════════════════════════════════════════════════════════════════════════
// Finance module (ported from financial-tracker; workspaceId → organizationId)
// ═══════════════════════════════════════════════════════════════════════════

enum FinAccountType {
  BANK
  CASH
  CRYPTO
  BROKERAGE
  CREDIT
  OTHER
}

enum CategoryKind {
  INCOME
  EXPENSE
}

enum TxnType {
  INCOME
  EXPENSE
  TRANSFER
}

enum RecurrenceFreq {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum TradeSide {
  BUY
  SELL
}

enum UnitKind {
  SHARES
  TOKENS
  LOTS
}

model FinAccount {
  id             String         @id @default(cuid())
  organizationId String
  // Optional attribution to a ProBase Project (relation wired in Phase 2).
  projectId      String?
  name           String
  type           FinAccountType
  currency       String
  openingBalance Decimal        @default(0) @db.Decimal(20, 4)
  archivedAt     DateTime?
  createdAt      DateTime       @default(now())

  organization          Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project               Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  txns                  Transaction[]        @relation("PrimaryAcct")
  counterTxns           Transaction[]        @relation("CounterAcct")
  recurringRulesPrimary RecurringRule[]      @relation("RecurringPrimaryAcct")
  recurringRulesCounter RecurringRule[]      @relation("RecurringCounterAcct")
  positions             Position[]
  investmentPositions   InvestmentPosition[]

  @@index([organizationId])
  @@index([projectId])
}

model Category {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  kind           CategoryKind
  parentId       String?
  monthlyBudget  Decimal?     @db.Decimal(20, 4)
  color          String?
  createdAt      DateTime     @default(now())

  parent         Category?       @relation("CategoryTree", fields: [parentId], references: [id])
  children       Category[]      @relation("CategoryTree")
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  txns           Transaction[]
  recurringRules RecurringRule[]

  @@index([organizationId])
}

model Transaction {
  id               String   @id @default(cuid())
  organizationId   String
  // Optional attribution to a ProBase Project (relation wired in Phase 2).
  projectId        String?
  finAccountId     String
  counterAccountId String?
  categoryId       String?
  positionId       String?
  date             DateTime
  amount           Decimal  @db.Decimal(20, 4)
  currency         String
  fxRate           Decimal  @db.Decimal(20, 8)
  baseAmount       Decimal  @db.Decimal(20, 4)
  type             TxnType
  memo             String?
  createdAt        DateTime @default(now())

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  finAccount     FinAccount       @relation("PrimaryAcct", fields: [finAccountId], references: [id])
  counterAccount FinAccount?      @relation("CounterAcct", fields: [counterAccountId], references: [id])
  category       Category?        @relation(fields: [categoryId], references: [id])
  position       Position?        @relation(fields: [positionId], references: [id])
  tags           TransactionTag[]
  lot            Lot?
  dividend       Dividend?

  @@index([organizationId, date])
  @@index([organizationId, categoryId, date])
  @@index([projectId])
}

model Tag {
  id             String @id @default(cuid())
  organizationId String
  name           String

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  txns         TransactionTag[]

  @@unique([organizationId, name])
}

model TransactionTag {
  transactionId String
  tagId         String

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tag         Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([transactionId, tagId])
}

model FxRate {
  id     String   @id @default(cuid())
  base   String
  quote  String
  rate   Decimal  @db.Decimal(20, 8)
  date   DateTime
  source String   @default("frankfurter")

  @@unique([base, quote, date])
  @@index([date])
}

model RecurringRule {
  id               String         @id @default(cuid())
  organizationId   String
  finAccountId     String
  counterAccountId String?
  categoryId       String?
  type             TxnType
  amount           Decimal        @db.Decimal(20, 4)
  currency         String
  memo             String?
  freq             RecurrenceFreq
  interval         Int            @default(1)
  startDate        DateTime
  nextRunDate      DateTime
  endDate          DateTime?
  lastPostedAt     DateTime?
  createdAt        DateTime       @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  finAccount     FinAccount   @relation("RecurringPrimaryAcct", fields: [finAccountId], references: [id], onDelete: Cascade)
  counterAccount FinAccount?  @relation("RecurringCounterAcct", fields: [counterAccountId], references: [id], onDelete: SetNull)
  category       Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([organizationId, nextRunDate])
  @@index([organizationId])
}

model Position {
  id             String   @id @default(cuid())
  organizationId String
  finAccountId   String
  symbol         String
  unitKind       UnitKind @default(SHARES)
  createdAt      DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  finAccount   FinAccount    @relation(fields: [finAccountId], references: [id], onDelete: Cascade)
  lots         Lot[]
  txns         Transaction[]

  @@unique([finAccountId, symbol])
  @@index([organizationId])
}

model Lot {
  id            String    @id @default(cuid())
  positionId    String
  transactionId String    @unique
  side          TradeSide
  quantity      Decimal   @db.Decimal(20, 8)
  unitCost      Decimal   @db.Decimal(20, 8)
  fee           Decimal   @default(0) @db.Decimal(20, 4)
  remainingQty  Decimal   @db.Decimal(20, 8)
  acquiredDate  DateTime
  closedAt      DateTime?
  createdAt     DateTime  @default(now())

  position    Position    @relation(fields: [positionId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([positionId])
}

model InvestmentPosition {
  id             String    @id @default(cuid())
  organizationId String
  finAccountId   String
  symbol         String
  name           String?
  currency       String
  lastPrice      Decimal?  @db.Decimal(20, 8)
  lastPriceAt    DateTime?
  realizedPl     Decimal   @default(0) @db.Decimal(20, 4)
  closedAt       DateTime?
  createdAt      DateTime  @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  finAccount   FinAccount      @relation(fields: [finAccountId], references: [id])
  lots         InvestmentLot[]
  dividends    Dividend[]

  @@index([organizationId])
  @@index([finAccountId])
}

model InvestmentLot {
  id                String   @id @default(cuid())
  positionId        String
  quantity          Decimal  @db.Decimal(20, 4)
  remainingQuantity Decimal  @db.Decimal(20, 4)
  costPerUnit       Decimal  @db.Decimal(20, 8)
  fees              Decimal? @db.Decimal(20, 4)
  acquiredAt        DateTime
  createdAt         DateTime @default(now())

  position InvestmentPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@index([positionId, acquiredAt])
}

model Dividend {
  id            String   @id @default(cuid())
  positionId    String
  totalAmount   Decimal  @db.Decimal(20, 4)
  currency      String
  payDate       DateTime
  transactionId String?  @unique
  createdAt     DateTime @default(now())

  position    InvestmentPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)
  transaction Transaction?       @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([positionId, payDate])
}

// ═══════════════════════════════════════════════════════════════════════════
// Projects module (ported from ProBase; workspaceId → organizationId,
// Workspace → Organization, WorkspaceMember → Membership). Status/priority/kind
// kept as free-form Strings as in the source; JSON payloads kept as String.
// ═══════════════════════════════════════════════════════════════════════════

// Reusable blueprint scoped to an org. `kind` is "TASK" or "PROJECT";
// `content` is JSON-encoded text describing what to instantiate.
model Template {
  id             String   @id @default(cuid())
  organizationId String
  kind           String
  name           String
  description    String?
  content        String
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  // Relation field named `workspace` (ProBase term) but points at Organization.
  workspace      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User         @relation(fields: [createdById], references: [id])

  @@index([organizationId, kind])
}

model Project {
  id             String      @id @default(cuid())
  name           String
  description    String?
  color          String      @default("#6366f1")
  icon           String?
  status         String      @default("ACTIVE")
  organizationId String
  createdById    String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  // Relation field named `workspace` (ProBase term) but points at Organization.
  workspace      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  tasks          Task[]
  milestones     Milestone[]
  labels         Label[]
  // Finance attribution (Phase 1 columns wired here).
  finAccounts    FinAccount[]
  transactions   Transaction[]

  @@index([organizationId])
}

model Task {
  id              String     @id @default(cuid())
  title           String
  description     String?
  status          String     @default("TODO")
  priority        String     @default("MEDIUM")
  dueDate         DateTime?
  startDate       DateTime?
  order           Float      @default(0)
  projectId       String
  assigneeId      String?
  creatorId       String
  parentId        String?
  milestoneId     String?
  recurrence      String?
  recurrenceEnd   DateTime?
  recurringFromId String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  project         Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator         User       @relation("TaskCreator", fields: [creatorId], references: [id])
  assignee        User?      @relation("TaskAssignee", fields: [assigneeId], references: [id])
  parent          Task?      @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subTasks        Task[]     @relation("Subtasks")
  milestone       Milestone? @relation(fields: [milestoneId], references: [id])
  comments        Comment[]
  labels          Label[]    @relation("TaskLabels")
  activities      TaskActivity[]
  attachments     TaskAttachment[]
  blocking        TaskDependency[] @relation("blocker")
  blockedBy       TaskDependency[] @relation("blocked")

  @@index([projectId])
}

model TaskDependency {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   Task     @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   Task     @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@index([blockerId])
}

model TaskAttachment {
  id           String   @id @default(cuid())
  taskId       String
  uploaderId   String
  name         String
  size         Int
  mimeType     String?
  msItemId     String
  msDriveId    String?
  shareUrl     String
  thumbnailUrl String?
  createdAt    DateTime @default(now())
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploader     User     @relation(fields: [uploaderId], references: [id])

  @@index([taskId, createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  taskId    String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
}

model Label {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#6366f1")
  projectId String?
  createdAt DateTime @default(now())
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]   @relation("TaskLabels")
}

model Milestone {
  id          String    @id @default(cuid())
  name        String
  description String?
  dueDate     DateTime?
  projectId   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks       Task[]
}

// Task timeline event (ProBase Activity, renamed to avoid clashing with the
// platform's cross-cutting Activity).
model TaskActivity {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  kind      String
  metadata  String?
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@index([userId, createdAt])
}

// Per-recipient task notification (ProBase Notification, renamed).
model TaskNotification {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  taskId    String?
  commentId String?
  actorId   String?
  metadata  String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
}

// ═══════════════════════════════════════════════════════════════════════════
// Field module (ported from FieldFlow; company → Organization). Dates kept as
// ISO String ('YYYY-MM-DD') to stay compatible with the Python compute engine
// that reads this Postgres. node_type/flow_type/status validated app-side.
// ═══════════════════════════════════════════════════════════════════════════

// @map keeps the physical Postgres tables/columns identical to FieldFlow's
// sqlite schema (snake_case, `company_id`), so the Python compute engine reads
// them with its existing SQL. Prisma client field names stay camelCase, so the
// Next.js code is unaffected.
model Node {
  id             String   @id @default(cuid())
  organizationId String   @map("company_id")
  code           String
  name           String
  nodeType       String   @map("node_type")
  capacity       Float?
  unit           String   @default("bbl")
  parentCode     String?  @map("parent_code")
  active         Boolean  @default(true)
  notes          String?
  openingStock   Float    @default(0) @map("opening_stock")
  createdAt      DateTime @default(now()) @map("created_at")

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  flows         Flow[]
  transfersOut  Transfer[]   @relation("TransferFrom")
  transfersIn   Transfer[]   @relation("TransferTo")
  liftingsFrom  Lifting[]    @relation("LiftingFrom")
  liftingsBuyer Lifting[]    @relation("LiftingBuyer")
  targets       Target[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("nodes")
}

model Flow {
  id             String   @id @default(cuid())
  organizationId String   @map("company_id")
  nodeId         String   @map("node_id")
  date           String
  flowType       String   @map("flow_type")
  volume         Float
  swPct          Float?   @map("sw_pct")
  category       String?
  status         String   @default("actual")
  memo           String?
  reportedBy     String?  @map("reported_by")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  node         Node         @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([organizationId, date])
  @@index([nodeId, date])
  @@map("flows")
}

model Transfer {
  id             String   @id @default(cuid())
  organizationId String   @map("company_id")
  fromNodeId     String   @map("from_node_id")
  toNodeId       String   @map("to_node_id")
  date           String
  volume         Float
  receiptVolume  Float?   @map("receipt_volume")
  memo           String?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromNode     Node         @relation("TransferFrom", fields: [fromNodeId], references: [id])
  toNode       Node         @relation("TransferTo", fields: [toNodeId], references: [id])

  @@index([organizationId, date])
  @@map("transfers")
}

model Lifting {
  id             String   @id @default(cuid())
  organizationId String   @map("company_id")
  fromNodeId     String?  @map("from_node_id")
  buyerNodeId    String?  @map("buyer_node_id")
  tankerName     String   @map("tanker_name")
  nominated      Float?
  blVolume       Float?   @map("bl_volume")
  cqdVolume      Float?   @map("cqd_volume")
  eta            String?
  laycanStart    String?  @map("laycan_start")
  laycanEnd      String?  @map("laycan_end")
  startLoad      String?  @map("start_load")
  stopLoad       String?  @map("stop_load")
  status         String   @default("tentative")
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromNode     Node?        @relation("LiftingFrom", fields: [fromNodeId], references: [id])
  buyerNode    Node?        @relation("LiftingBuyer", fields: [buyerNodeId], references: [id])

  @@index([organizationId])
  @@map("liftings")
}

model Target {
  id             String   @id @default(cuid())
  organizationId String   @map("company_id")
  nodeId         String   @map("node_id")
  year           Int
  month          Int
  category       String   @default("production")
  targetVol      Float?   @map("target_vol")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  node         Node         @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([organizationId, nodeId, year, month, category])
  @@index([organizationId])
  @@map("targets")
}

// Per-user dashboard widget layouts for the custom builder.
model UserDashboard {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  name       String   @default("My Dashboard")
  layoutJson String   @default("{\"widgets\":[]}") @map("layout_json")
  active     Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@map("user_dashboards")
}

// Per-user saved formula library (the bracket-reference DSL).
model UserFormula {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  name          String
  expr          String
  description   String?
  refSeriesMode String   @default("auto") @map("ref_series_mode")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
  @@map("user_formulas")
}

// Telegram reminder opt-ins (bot worker).
model ReminderSubscription {
  chatId       BigInt @map("chat_id")
  reminderType String @map("reminder_type")

  @@id([chatId, reminderType])
  @@map("reminder_subscriptions")
}

// Telegram bot audit trail (bot worker).
model BotAudit {
  id        String   @id @default(cuid())
  chatId    BigInt?  @map("chat_id")
  botUserId BigInt?  @map("user_id")
  username  String?
  fullName  String?  @map("full_name")
  eventType String   @map("event_type")
  command   String?
  payload   String?
  status    String   @default("ok")
  error     String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([chatId, createdAt])
  @@index([createdAt])
  @@map("bot_audit")
}
